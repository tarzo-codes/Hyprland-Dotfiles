// https://theindiandev.in/

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": "||  ||",
      "keyColor": "red"
    },
    "break",
    {
      "type": "os",
      "key": "󰣇 ",
      "keyColor": "blue",
      "format": "Powered by {pretty-name}"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "dim_"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "yellow",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "green",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "packages",
      "format": "{}",
      "key": " ",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "red"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
